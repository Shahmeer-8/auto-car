{
  "name": "auto-car",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env": "node scripts/load-env.mjs",
    "prestart": "node scripts/load-env.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/load-env.mjs --production",
    "build": "ng build",
    "build:dev": "node scripts/load-env.mjs && ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "firebase:rules": "firebase deploy --only firestore:rules,storage:rules,firestore:indexes"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.2.14",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "firebase": "^12.14.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/material": "^21.2.14",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}