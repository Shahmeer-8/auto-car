rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the signed-in user's own profile document (legacy userType checks).
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Legacy admin check (kept for backward compatibility during RBAC migration).
    function isAdmin() {
      return isSignedIn() && userDoc().userType == 'admin';
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().isActive == true;
    }

    // RBAC: permissions come from Auth custom claims (set only by a Cloud Function).
    function hasPerm(p) {
      return isSignedIn()
        && request.auth.token.permissions != null
        && (request.auth.token.permissions.hasAny(['*'])
            || request.auth.token.permissions.hasAny([p]));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || hasPerm('users.view');

      // Self-registration only as buyer/seller — never admin — and must start active.
      allow create: if isOwner(userId)
        && request.resource.data.userType in ['buyer', 'seller']
        && request.resource.data.isActive == true;

      // Staff with users.manage (or legacy admin) may change anything, including role fields.
      // Owners may edit their own profile but CANNOT touch privileged fields.
      allow update: if hasPerm('users.manage') || isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['userType', 'roleId', 'roleName', 'permissions', 'isActive']));

      allow delete: if hasPerm('users.manage') || isAdmin();

      match /savedCars/{carId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /cars/{carId} {
      allow read: if resource.data.status == 'approved'
        || (isSignedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin() || hasPerm('ads.view');

      allow create: if isActiveUser()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';

      // Moderators (ads.moderate) or legacy admins moderate freely.
      // Owners may edit their own listing but it stays 'pending' and ownership can't move.
      allow update: if isAdmin() || hasPerm('ads.moderate') || hasPerm('ads.edit')
        || (isSignedIn()
            && resource.data.sellerId == request.auth.uid
            && request.resource.data.sellerId == resource.data.sellerId
            && request.resource.data.status == 'pending');

      allow delete: if isAdmin() || hasPerm('ads.delete')
        || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // Dynamic RBAC roles: readable by any signed-in user (needed to render menus/labels);
    // only roles.manage may change them.
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if hasPerm('roles.manage') || isAdmin();
    }

    // Immutable audit trail: only Cloud Functions (Admin SDK) write; audit.view/admin reads.
    match /auditLogs/{logId} {
      allow read: if hasPerm('audit.view') || isAdmin();
      allow write: if false;
    }

    // In-app notifications: recipients read their own; admins also read/mark-read
    // role-targeted ones. Creation/deletion is server-side only (Cloud Functions).
    match /notifications/{notifId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || hasPerm('notifications.view') || isAdmin());
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && (resource.data.userId == request.auth.uid
            || ((hasPerm('notifications.view') || isAdmin()) && resource.data.role != null));
      allow create, delete: if false;
    }

    // Site configuration + CMS content: public read; cms.edit / settings.manage write.
    match /config/{docId} {
      allow read: if true;
      allow write: if hasPerm('cms.edit') || hasPerm('settings.manage') || isAdmin();
    }

    // Complaints & contact messages: signed-in users file complaints; the public
    // contact form may also create (validated, always 'open'); staff manage.
    match /complaints/{complaintId} {
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 300;
      allow read, update, delete: if hasPerm('customers.manage') || isAdmin();
    }

    // Newsletter signups: public create (email only), staff read/manage.
    match /newsletterSubscribers/{subId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.*@.*[.].*');
      allow read, update, delete: if hasPerm('customers.manage') || isAdmin();
    }

    // Car bookings. A buyer creates a booking only for themselves and only in the
    // initial unpaid state; they may then attach a payment reference or cancel their
    // own booking, and nothing else. Staff (orders.manage) drive every other
    // transition. Reads are limited to the two parties and staff.
    function isOrderStaff() {
      return hasPerm('orders.manage') || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.carId is string
        && request.resource.data.carId.size() > 0
        && request.resource.data.reference is string
        && request.resource.data.depositAmount is number
        && request.resource.data.depositAmount >= 0
        && request.resource.data.carPrice is number
        && request.resource.data.buyerName is string
        && request.resource.data.buyerName.size() <= 200
        && request.resource.data.buyerPhone is string
        && request.resource.data.buyerPhone.size() <= 40;

      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isOrderStaff());

      // Buyer: may only submit a transfer reference or cancel, never change money/ownership.
      allow update: if isOrderStaff()
        || (isSignedIn()
            && resource.data.buyerId == request.auth.uid
            && request.resource.data.buyerId == resource.data.buyerId
            && request.resource.data.carId == resource.data.carId
            && request.resource.data.depositAmount == resource.data.depositAmount
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['paymentReference', 'status', 'updatedAt'])
            && request.resource.data.status in ['payment_review', 'cancelled']
            && resource.data.status in ['pending_payment', 'payment_review']);

      allow delete: if isOrderStaff();
    }
  }
}
